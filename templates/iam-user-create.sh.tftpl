#!/usr/bin/env bash
# This script uses the AWS RDS Data API to create and manage database users for
# RDS authentication. This allows us to create users without needing to manage
# passwords. Using the Data API prevents us from needing to connect directly to
# the database to perform these operations.
#
# Note: This script is generated from a template and meant to be run by
# OpenTofu's local-exec provisioner. It is not intended to be used directly.
set -euo pipefail

# Set variables from template inputs.
CLUSTER_ARN="${cluster_arn}"
ENGINE="${engine}"
DATABASES_CSV="${databases_csv}"
REGION="${region}"
PRIVILEGES="${privileges}"
SECRET_ARN="${secret_arn}"
USERNAME="${username}"
MANAGE_DATABASES="${manage_databases}"
OWNED_DATABASES_CSV="${owned_databases_csv}"

# Disable the AWS pager.
export AWS_PAGER=""

#######################################
# Run a SQL statement against the database using the RDS Data API.
#
# Globals:
#   CLUSTER_ARN
#   REGION
#   SECRET_ARN
# Arguments:
#   Database to run the statement against, and the SQL statement to execute.
#   Optionally, whether to output the response, defaults to false.
# Outputs:
#   SQL error message if the statement fails.
#   Optionally, the JSON response from the AWS CLI.
# Returns:
#   0 if the statement succeeds, 1 otherwise.
#######################################
run_sql() {
  local database="$1"
  local sql="$2"
  local output_response="$${3:-false}"

  # Capture output and error
  local output
  if ! output=$(
    aws rds-data execute-statement \
      --region        "$REGION" \
      --resource-arn  "$CLUSTER_ARN" \
      --secret-arn    "$SECRET_ARN" \
      --database      "$database" \
      --sql           "$sql" \
      --output        json 2>&1
  ); then
    echo "Error running SQL against database \"$database\":"
    echo "$sql"
    echo "AWS CLI output:"
    echo "$output"
    return 1
  fi

  # On success, print the JSON output only if output_response is true. This
  # allows callers to capture the output if needed, but we don't want to print
  # it by default.
  if [ "$output_response" = true ]; then
    echo "$output"
  fi
}

# Wait for the Data API to become reachable (up to 3 minutes).
PING_DB="$( [ "$ENGINE" = "mysql" ] && echo "mysql" || echo "postgres" )"
for attempt in $(seq 1 18); do
  run_sql "$PING_DB" "SELECT 1" > /dev/null 2>&1 && break
  echo "Data API not yet available, retrying in 10s (attempt $attempt/18)..."
  sleep 10
done

# AWS Aurora supports both MySQL and PostgreSQL engines, which each have their
# own syntax for user and privilege management.
if [ "$ENGINE" = "mysql" ]; then
  GRANT_CLAUSE="ALL PRIVILEGES"
  [ "$PRIVILEGES" = "readonly" ] && GRANT_CLAUSE="SELECT"

  run_sql "mysql" \
    "CREATE USER IF NOT EXISTS '$USERNAME'@'%' IDENTIFIED WITH AWSAuthenticationPlugin AS 'RDS';"

  # If DATABASES_CSV is empty, grant privileges globally. Otherwise, we want to
  # limit privileges to the specified databases.
  if [ -z "$DATABASES_CSV" ]; then
    run_sql "mysql" "GRANT $GRANT_CLAUSE ON *.* TO '$USERNAME'@'%';"
  else
    IFS=',' read -ra DBS <<< "$DATABASES_CSV"
    for DB in "$${DBS[@]}"; do
      run_sql "mysql" "GRANT $GRANT_CLAUSE ON \`$DB\`.* TO '$USERNAME'@'%';"
    done
  fi

  # Flush privileges to ensure they take effect immediately.
  run_sql "mysql" "FLUSH PRIVILEGES;"
elif [ "$ENGINE" = "postgresql" ]; then
  GRANT_CLAUSE="ALL PRIVILEGES"
  [ "$PRIVILEGES" = "readonly" ] && GRANT_CLAUSE="SELECT"

  run_sql "postgres" \
    "DO \$\$BEGIN IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '$USERNAME') THEN CREATE USER \"$USERNAME\"; END IF; END\$\$;"
  run_sql "postgres" "GRANT rds_iam TO \"$USERNAME\";"

  # Apps-sourced roles get their databases created automatically. Owned
  # databases (OWNED_DATABASES_CSV) get CREATE back via ownership; shared
  # ones get no OWNER here and an explicit grant below instead (see README).
  # No CREATE DATABASE IF NOT EXISTS in Postgres, so existence is checked
  # manually.
  if [ "$MANAGE_DATABASES" = "true" ]; then
    # Master must SET ROLE to the owner to CREATE DATABASE ... OWNER on PG16+.
    run_sql "postgres" "GRANT \"$USERNAME\" TO root;"

    IFS=',' read -ra OWNED_DBS <<< "$OWNED_DATABASES_CSV"
    IFS=',' read -ra ALL_DBS <<< "$DATABASES_CSV"

    for DB in "$${ALL_DBS[@]}"; do
      is_owner=false
      for owned in "$${OWNED_DBS[@]:-}"; do
        [ "$owned" = "$DB" ] && { is_owner=true; break; }
      done

      exists=$(run_sql "postgres" "SELECT 1 FROM pg_database WHERE datname = '$DB';" true | jq -r '.records | length')
      if [ "$exists" = "0" ]; then
        if $is_owner; then
          echo "Creating database $DB owned by $USERNAME..."
          run_sql "postgres" "CREATE DATABASE \"$DB\" OWNER \"$USERNAME\";"
        else
          echo "Creating shared database $DB (no single owner)..."
          if ! run_sql "postgres" "CREATE DATABASE \"$DB\";"; then
            # A sibling service may have won the create race — only a real
            # failure if it's still missing.
            still_missing=$(run_sql "postgres" "SELECT 1 FROM pg_database WHERE datname = '$DB';" true | jq -r '.records | length')
            if [ "$still_missing" = "0" ]; then
              echo "Failed to create database $DB"
              exit 1
            fi
          fi
        fi
      elif $is_owner; then
        # Owner may have drifted since creation — reconcile rather than
        # assume it still holds.
        current_owner=$(run_sql "postgres" "SELECT pg_catalog.pg_get_userbyid(datdba) FROM pg_database WHERE datname = '$DB';" true | jq -r '.records[0][0].stringValue')
        if [ "$current_owner" != "$USERNAME" ]; then
          echo "Reassigning database $DB ownership from $current_owner to $USERNAME..."
          run_sql "postgres" "ALTER DATABASE \"$DB\" OWNER TO \"$USERNAME\";"
        fi
      else
        # Not the designated owner — either always shared, or a service
        # was added and this db no longer has a single owner. A prior
        # owner must be reclaimed, since shared databases must not leave
        # an elevated owner behind.
        current_owner=$(run_sql "postgres" "SELECT pg_catalog.pg_get_userbyid(datdba) FROM pg_database WHERE datname = '$DB';" true | jq -r '.records[0][0].stringValue')
        if [ "$current_owner" != "root" ]; then
          echo "Reclaiming database $DB ownership from $current_owner to root (no longer single-owned)..."
          run_sql "postgres" "ALTER DATABASE \"$DB\" OWNER TO root;"
        fi
      fi
    done
  fi

  # Get a list of all existing databases.
  dblist=$(
    run_sql "postgres" \
      "SELECT datname FROM pg_database WHERE datistemplate = false AND datallowconn = true;" \
      true |
      jq -r '.records[][].stringValue' |
      grep -v '^rdsadmin$'
  )

  # If DATABASES_CSV is empty, grant privileges globally. Otherwise, we want to
  # limit privileges to the specified databases.
  if [ -z "$DATABASES_CSV" ]; then
    # Grant privileges to all current databases.
    for DB in $dblist; do
      echo "Granting $USERNAME $GRANT_CLAUSE privileges to database $DB..."
      run_sql "$DB" "GRANT CONNECT ON DATABASE \"$DB\" TO \"$USERNAME\";"
      run_sql "$DB" "GRANT USAGE ON SCHEMA public TO \"$USERNAME\";"
      run_sql "$DB" "GRANT $GRANT_CLAUSE ON ALL TABLES IN SCHEMA public TO \"$USERNAME\";"
      run_sql "$DB" "GRANT $GRANT_CLAUSE ON ALL SEQUENCES IN SCHEMA public TO \"$USERNAME\";"
      run_sql "$DB" "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT $GRANT_CLAUSE ON TABLES TO \"$USERNAME\";"
      run_sql "$DB" "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT $GRANT_CLAUSE ON SEQUENCES TO \"$USERNAME\";"
    done

    # If the user is granted all privileges, they should be allowed to create
    # databases. Read-only users should not.
    if [ "$PRIVILEGES" = "all" ]; then
      run_sql "postgres" "ALTER USER \"$USERNAME\" WITH CREATEDB;"
    else
      run_sql "postgres" "ALTER USER \"$USERNAME\" WITH NOCREATEDB;"
    fi
  else
    IFS=',' read -ra DBS <<< "$DATABASES_CSV"
    for DB in "$${DBS[@]}"; do
      echo "Granting $USERNAME $GRANT_CLAUSE privileges to database $DB..."
      run_sql "$DB" "GRANT CONNECT ON DATABASE \"$DB\" TO \"$USERNAME\";"
      run_sql "$DB" "GRANT USAGE ON SCHEMA public TO \"$USERNAME\";"
      run_sql "$DB" "GRANT $GRANT_CLAUSE ON ALL TABLES IN SCHEMA public TO \"$USERNAME\";"
      run_sql "$DB" "GRANT $GRANT_CLAUSE ON ALL SEQUENCES IN SCHEMA public TO \"$USERNAME\";"
      run_sql "$DB" "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT $GRANT_CLAUSE ON TABLES TO \"$USERNAME\";"
      run_sql "$DB" "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT $GRANT_CLAUSE ON SEQUENCES TO \"$USERNAME\";"

      # Owner gets CREATE via PG15+'s pg_database_owner; a role with no
      # ownership on this database needs it granted directly.
      if [ "$MANAGE_DATABASES" = "true" ]; then
        owns_db=false
        for owned in "$${OWNED_DBS[@]:-}"; do
          [ "$owned" = "$DB" ] && { owns_db=true; break; }
        done
        $owns_db || run_sql "$DB" "GRANT CREATE ON SCHEMA public TO \"$USERNAME\";"
      fi
    done

    # Make sure the user doesn't have access to any other databases.
    for DB in $dblist; do
      in_dbs=false
      for dbname in "$${DBS[@]}"; do
        if [[ "$dbname" == "$${DB}" ]]; then
          in_dbs=true
          break
        fi
      done

      if ! $in_dbs; then
        echo "Revoking $USERNAME privileges from database $DB..."
        run_sql "$DB" "REVOKE CONNECT ON DATABASE \"$DB\" FROM \"$USERNAME\";"
        run_sql "$DB" "REVOKE USAGE ON SCHEMA public FROM \"$USERNAME\";"
        run_sql "$DB" "REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA public FROM \"$USERNAME\";"
        run_sql "$DB" "REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public FROM \"$USERNAME\";"
        run_sql "$DB" "ALTER DEFAULT PRIVILEGES IN SCHEMA public REVOKE ALL PRIVILEGES ON TABLES FROM \"$USERNAME\";"
        run_sql "$DB" "ALTER DEFAULT PRIVILEGES IN SCHEMA public REVOKE ALL PRIVILEGES ON SEQUENCES FROM \"$USERNAME\";"
      fi
    done

    # The user shouldn't be allowed to create new databases.
    run_sql "postgres" "ALTER USER \"$USERNAME\" WITH NOCREATEDB;"
  fi
fi
