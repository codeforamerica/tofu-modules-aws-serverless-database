#!/usr/bin/env bash
# This script uses the AWS RDS Data API to delete database users created for
# RDS authentication.
#
# Note: This script is generated from a template and meant to be run by
# OpenTofu's local-exec provisioner. It is not intended to be used directly.
set -euo pipefail

# Set variables from template inputs.
CLUSTER_ARN="${cluster_arn}"
ENGINE="${engine}"
REGION="${region}"
SECRET_ARN="${secret_arn}"
USERNAME="${username}"
MANAGE_DATABASES="${manage_databases}"
OWNED_DATABASES_CSV="${owned_databases_csv}"

#######################################
# Run a SQL statement against the database using the RDS Data API. If the
# statement fails, we log a warning and continue as the database cluster
# may already be deleted.
#
# Globals:
#   CLUSTER_ARN
#   REGION
#   SECRET_ARN
# Arguments:
#   Database to run the statement against, and the SQL statement to execute.
#   Optionally, whether to output the response, defaults to false.
# Outputs:
#   SQL error message if the statement fails.
#   Optionally, the JSON response from the AWS CLI.
# Returns:
#   0 in all cases (failures are logged but we do not exit).
#######################################
run_sql() {
  local database="$1"
  local sql="$2"
  local output_response="$${3:-false}"

  # Capture output and error
  local output
  if ! output=$(
    aws rds-data execute-statement \
      --region        "$REGION" \
      --resource-arn  "$CLUSTER_ARN" \
      --secret-arn    "$SECRET_ARN" \
      --database      "$database" \
      --sql           "$sql" \
      --output        json 2>&1
  ); then
    echo "Error running SQL against database \"$database\":" >&2
    echo "$sql" >&2
    echo "AWS CLI output:" >&2
    echo "$output" >&2
    echo "Warning: SQL failed (cluster may already be gone), continuing." >&2
    return 0
  fi

  # On success, print the JSON output only if output_response is true. This
  # allows callers to capture the output if needed, but we don't want to print
  # it by default.
  if [ "$output_response" = true ]; then
    echo "$output"
  fi
}

# Wait for the Data API to become reachable (up to 3 minutes). Doesn't use
# run_sql, which always returns 0 here — this needs the real exit code.
PING_DB="$( [ "$ENGINE" = "mysql" ] && echo "mysql" || echo "postgres" )"
for attempt in $(seq 1 18); do
  aws rds-data execute-statement \
    --region       "$REGION" \
    --resource-arn "$CLUSTER_ARN" \
    --secret-arn   "$SECRET_ARN" \
    --database     "$PING_DB" \
    --sql          "SELECT 1" \
    --output       json > /dev/null 2>&1 && break
  echo "Data API not yet available, retrying in 10s (attempt $attempt/18)..."
  sleep 10
done

# AWS Aurora supports both MySQL and PostgreSQL engines, which each have their
# own syntax for user and privilege management.
if [ "$ENGINE" = "mysql" ]; then
  run_sql "mysql" "DROP USER IF EXISTS '$USERNAME'@'%';"
  run_sql "mysql" "FLUSH PRIVILEGES;"
elif [ "$ENGINE" = "postgresql" ]; then
  # For PostgreSQL, we need to revoke privileges before dropping the user.
  # Otherwise, it may fail if the user is still attached to any databases.
  run_sql "postgres" "REVOKE rds_iam FROM \"$USERNAME\";"

  # root needs membership in the role to reassign anything away from it,
  # below and in the per-database loop.
  run_sql "postgres" "GRANT \"$USERNAME\" TO root;"

  # DROP USER fails if the role still owns a database, so reassign that first.
  if [ "$MANAGE_DATABASES" = "true" ] && [ -n "$OWNED_DATABASES_CSV" ]; then
    IFS=',' read -ra OWNED_DBS <<< "$OWNED_DATABASES_CSV"
    for DB in "$${OWNED_DBS[@]}"; do
      echo "Reassigning ownership of $DB from $USERNAME to root..."
      run_sql "postgres" "ALTER DATABASE \"$DB\" OWNER TO root;"
    done
  fi

  # Get a list of all existing databases.
  dblist=$(
    run_sql "postgres" \
      "SELECT datname FROM pg_database WHERE datistemplate = false AND datallowconn = true;" \
      true |
      jq -r '.records[][].stringValue' |
      grep -v '^rdsadmin$' || true
  )

  # Just to be safe, revoke privileges from all databases.
  for DB in $dblist; do
    echo "Revoking $USERNAME privileges from database $DB..."
    # DROP USER also fails if the role owns any tables (e.g. from past
    # migrations), not just a database — reassign those too. No DROP OWNED
    # after this: run_sql swallows failures, so if REASSIGN quietly failed,
    # DROP OWNED would delete the role's tables instead of leaving them
    # with a stuck role — a stuck role is the safer failure mode.
    run_sql "$DB" "REASSIGN OWNED BY \"$USERNAME\" TO root;"
    run_sql "$DB" "REVOKE CONNECT ON DATABASE \"$DB\" FROM \"$USERNAME\";"
    run_sql "$DB" "REVOKE USAGE ON SCHEMA public FROM \"$USERNAME\";"
    run_sql "$DB" "REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA public FROM \"$USERNAME\";"
    run_sql "$DB" "REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public FROM \"$USERNAME\";"
    run_sql "$DB" "ALTER DEFAULT PRIVILEGES IN SCHEMA public REVOKE ALL PRIVILEGES ON TABLES FROM \"$USERNAME\";"
    run_sql "$DB" "ALTER DEFAULT PRIVILEGES IN SCHEMA public REVOKE ALL PRIVILEGES ON SEQUENCES FROM \"$USERNAME\";"
  done

  run_sql "postgres" "DROP USER IF EXISTS \"$USERNAME\";"
fi
